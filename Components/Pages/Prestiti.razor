@page "/prestiti"
@rendermode InteractiveServer
@inject Db Db

<PageTitle>Prestiti — Alexandreia</PageTitle>
<h2>Prestiti</h2>

<div class="toolbar">
    <input type="search" placeholder="Cerca per titolo o per persona…" @bind="q" @bind:event="oninput" />
    <label><input type="checkbox" @bind="showAll" /> mostra anche i rientrati</label>
</div>

@if (msg is not null)
{
    <div class="msg ok">@msg</div>
}

@{ var loans = Db.Loans(openOnly: !showAll, search: q); }

<table>
    <thead>
        <tr>
            <th>Titolo</th><th>A chi</th><th>Prestato il</th><th>Rientro entro</th><th>Rientrato</th><th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var l in loans)
        {
            <tr>
                <td>@l.Title <span class="muted">@l.Author</span></td>
                <td>@l.Borrower</td>
                <td>@l.LoanedAt.ToString("dd/MM/yyyy")</td>
                <td class="@(l.Overdue ? "overdue" : "")">
                    @l.DueAt.ToString("dd/MM/yyyy")
                    @if (l.Overdue) { <text> — in ritardo di @((DateTime.Today - l.DueAt.Date).Days) gg</text> }
                </td>
                <td>@(l.ReturnedAt?.ToString("dd/MM/yyyy") ?? "")</td>
                <td>
                    @if (l.ReturnedAt is null)
                    {
                        <button class="ghost" @onclick="() => Return(l)">Rientrato</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (loans.Count == 0)
{
    <p class="empty">@(showAll ? "Nessun prestito registrato." : "Nessun libro attualmente fuori.")</p>
}

@code {
    string? q;
    bool showAll;
    string? msg;

    void Return(Loan l) =>
        msg = Db.Return(l.Id)
            ? $"«{l.Title}» rientrato."
            : $"«{l.Title}» risultava già rientrato.";
}
