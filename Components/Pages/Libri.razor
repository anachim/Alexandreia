@page "/"
@page "/libri"
@rendermode InteractiveServer
@inject Db Db
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Libri — Alexandreia</PageTitle>
<h2>Libri</h2>

<div class="toolbar">
    <input type="search" placeholder="Cerca titolo, autore, ISBN…" @bind="q" @bind:event="oninput" />
    <label><input type="checkbox" @bind="onlyAvailable" /> solo disponibili</label>
    <span class="grow"></span>
    <button @onclick="@(() => Nav.NavigateTo("libri/nuovo"))">Nuovo libro</button>
</div>

@if (msg is not null)
{
    <div class="msg @(ok ? "ok" : "")">@msg</div>
}

@if (lending is not null)
{
    <form class="toolbar" @onsubmit="Lend" @formname="lend">
        <strong>Presta «@lending.Title»</strong>
        <input placeholder="A chi?" @bind="borrower" @bind:event="oninput" autofocus />
        <label class="muted">rientro entro</label>
        <input type="date" @bind="dueAt" />
        <button type="submit" disabled="@string.IsNullOrWhiteSpace(borrower)">Conferma</button>
        <button type="button" class="ghost" @onclick="@(() => lending = null)">Annulla</button>
    </form>
}

@{ var books = Db.Books(q, onlyAvailable); }

<table>
    <thead>
        <tr>
            <th>Titolo</th><th>Autore</th><th class="num">Anno</th><th>Collocazione</th>
            <th class="num">Disp.</th><th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in books)
        {
            <tr>
                <td>@b.Title</td>
                <td>@b.Author</td>
                <td class="num">@b.Year</td>
                <td>@b.Location</td>
                <td class="num">@b.Available / @b.Copies</td>
                <td>
                    <button class="ghost" disabled="@(b.Available <= 0)" @onclick="() => StartLend(b)">Presta</button>
                    <button class="ghost" @onclick="@(() => Nav.NavigateTo($"libri/{b.Id}"))">Modifica</button>
                    <button class="ghost" @onclick="() => Archive(b)">Archivia</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (books.Count == 0)
{
    <p class="empty">Nessun libro@(string.IsNullOrWhiteSpace(q) ? " ancora. Comincia da «Nuovo libro»." : " trovato.")</p>
}
else if (books.Count == 200)
{
    <p class="muted">Mostrati i primi 200 risultati — restringi la ricerca.</p>
}

@code {
    string? q;
    bool onlyAvailable;
    string? msg;
    bool ok;

    Book? lending;
    string borrower = "";
    DateTime dueAt = DateTime.Today.AddDays(30);

    void StartLend(Book b)
    {
        lending = b;
        borrower = "";
        dueAt = DateTime.Today.AddDays(30);
        msg = null;
    }

    void Lend()
    {
        if (lending is null) return;
        if (Db.Lend(lending.Id, borrower, dueAt))
        {
            (msg, ok) = ($"«{lending.Title}» prestato a {borrower.Trim()}, rientro entro {dueAt:dd/MM/yyyy}.", true);
            lending = null;
        }
        else
        {
            (msg, ok) = ("Nessuna copia disponibile: qualcuno l'ha già presa.", false);
        }
    }

    async Task Archive(Book b)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Archiviare «{b.Title}»? Sparisce dall'elenco, lo storico prestiti resta."))
            return;
        (msg, ok) = Db.ArchiveBook(b.Id)
            ? ($"«{b.Title}» archiviato.", true)
            : ($"«{b.Title}» ha ancora copie in prestito: prima registra il rientro.", false);
    }
}
