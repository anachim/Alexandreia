<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Alexandreia.App">

    <Application.Resources>
        <ResourceDictionary>
            <!-- The reference world is not the antique book, it is library administration:
                 ledgers, shelf tags, and the violet date-due stamp — where the accent
                 comes from.

                 Dark is not the inverse of light: the colours keep their meaning, not their
                 brightness. Violet and vermilion lighten up to stay readable on a dark
                 ground, and the ground stays ink blue instead of turning black. -->
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Paper"     Color="#EFF1EC" />
                    <SolidColorBrush x:Key="Card"      Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Ink"       Color="#1B2430" />
                    <SolidColorBrush x:Key="Muted"     Color="#79808C" />
                    <SolidColorBrush x:Key="Rule"      Color="#D8DCD5" />
                    <SolidColorBrush x:Key="Stamp"     Color="#4C3F8F" />
                    <SolidColorBrush x:Key="StampDeep" Color="#3E3378" />
                    <SolidColorBrush x:Key="StampSoft" Color="#EDE9F7" />
                    <SolidColorBrush x:Key="Late"      Color="#B23A2E" />
                    <SolidColorBrush x:Key="LateDeep"  Color="#96301F" />
                    <SolidColorBrush x:Key="LateSoft"  Color="#FAEDEB" />
                    <SolidColorBrush x:Key="Free"      Color="#2E6B5E" />
                    <SolidColorBrush x:Key="FreeSoft"  Color="#E6F0EC" />
                    <SolidColorBrush x:Key="DoneSoft"  Color="#ECEDEA" />
                    <!-- Text on top of a filled button: light on a dark accent. -->
                    <SolidColorBrush x:Key="OnAccent"  Color="#FFFFFF" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Paper"     Color="#171B21" />
                    <SolidColorBrush x:Key="Card"      Color="#1F242C" />
                    <SolidColorBrush x:Key="Ink"       Color="#E7EAE6" />
                    <SolidColorBrush x:Key="Muted"     Color="#98A0AC" />
                    <SolidColorBrush x:Key="Rule"      Color="#333A44" />
                    <SolidColorBrush x:Key="Stamp"     Color="#9B8CE8" />
                    <SolidColorBrush x:Key="StampDeep" Color="#B0A3F0" />
                    <SolidColorBrush x:Key="StampSoft" Color="#2A2540" />
                    <SolidColorBrush x:Key="Late"      Color="#E8796A" />
                    <SolidColorBrush x:Key="LateDeep"  Color="#F0907F" />
                    <SolidColorBrush x:Key="LateSoft"  Color="#3A2320" />
                    <SolidColorBrush x:Key="Free"      Color="#6FBFA6" />
                    <SolidColorBrush x:Key="FreeSoft"  Color="#1E332D" />
                    <SolidColorBrush x:Key="DoneSoft"  Color="#2A3038" />
                    <!-- Here the accent is light, so the text on top must be dark:
                         white on light violet does not read. -->
                    <SolidColorBrush x:Key="OnAccent"  Color="#171B21" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource Paper}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>

        <!-- Typography: a single family, personality from scale and spacing. -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>
        <Style Selector="TextBlock.h">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="LetterSpacing" Value="1.4" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <Style Selector="TextBlock.overdue">
            <Setter Property="Foreground" Value="{DynamicResource Late}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.ok">
            <Setter Property="Foreground" Value="{DynamicResource Free}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Tabs: a tall strip, the selected one marked by the accent. -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource Stamp}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{DynamicResource Stamp}" />
        </Style>

        <!-- Buttons: neutral by default, filled for the action that changes the archive,
             vermilion for the one that deletes. Colour here is information, not decoration. -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource Stamp}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stamp}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,7" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StampDeep}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource Late}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Late}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,7" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LateDeep}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        </Style>

        <!-- Buttons inside rows run tight: the padding of ordinary buttons would push them
             out of the column. -->
        <Style Selector="DataGridCell Button">
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Utility button: present, but not competing with what surrounds it. -->
        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="Button.quiet:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Late}" />
        </Style>
        <Style Selector="Button.quiet:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource Stamp}" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <!-- Clickable stat card: it lifts just enough to say it can be pressed. -->
        <Style Selector="Border.stat">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.stat.clickable:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource Stamp}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- The state of a loan, spelled out rather than left to a symbol to decode. -->
        <Style Selector="Border.pill">
            <Setter Property="Background" Value="{DynamicResource FreeSoft}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.pill > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Free}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.pill.late">
            <Setter Property="Background" Value="{DynamicResource LateSoft}" />
        </Style>
        <Style Selector="Border.pill.late > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Late}" />
        </Style>
        <Style Selector="Border.pill.done">
            <Setter Property="Background" Value="{DynamicResource DoneSoft}" />
        </Style>
        <Style Selector="Border.pill.done > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- A single target for two ways of doing the same thing: press and pick, or drag
             and drop. It is a button and not a plain box, so it is reachable from the
             keyboard too. -->
        <Style Selector="Button.drop">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <!-- Stretch and not Center: with centred content the inner panel is only as
                 wide as the text, and whatever docks right ends up next to it. -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.drop:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource StampSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stamp}" />
        </Style>

        <!-- Bar for the operation that wipes everything: it has to be noticed before, not after. -->
        <Style Selector="Border.warning">
            <Setter Property="Background" Value="{DynamicResource LateSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Late}" />
            <Setter Property="BorderThickness" Value="1,1,1,1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="LetterSpacing" Value="0.8" />
            <!-- Without it, on the dark theme the header strip stays black and detaches
                 from the table instead of belonging to it. -->
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Rule}" />
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="RowBackground" Value="{DynamicResource Card}" />
        </Style>
    </Application.Styles>
</Application>
