<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Alexandreia.MainWindow"
        Title="Alexandreia" Width="1240" Height="760"
        WindowStartupLocation="CenterScreen">

    <!-- Il bottone del tema galleggia sul lato destro della striscia, che è spazio vuoto:
         non merita una riga tutta sua. -->
    <Grid Margin="10">
        <TabControl Name="Tabs">
            <TabItem Header="Libri" />
            <TabItem Header="Utenti" />
            <TabItem Header="Prestiti" />
            <TabItem Header="Metriche" />
            <TabItem Header="Dati" />
        </TabControl>

        <Button Name="Tema" Classes="quiet" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,6,4,0" FontSize="13" />
    </Grid>
</Window>
