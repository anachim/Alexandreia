<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Alexandreia"
             x:Class="Alexandreia.ImportView"
             DragDrop.AllowDrop="True">

    <DockPanel LastChildFill="True">

        <TextBlock DockPanel.Dock="Top" Text="PORTA I DATI FUORI" Classes="h" Margin="0,0,0,10" />

        <!-- Le due direzioni sono due riquadri uguali: si guardano di fianco, e uno più
             squillante dell'altro farebbe pensare che conti di più. Il pieno resta al
             solo bottone che cambia l'archivio. -->
        <Button Name="DoExport" DockPanel.Dock="Top" Classes="drop" Margin="0,0,0,10">
            <StackPanel Spacing="4">
                <TextBlock Text="Salva l'archivio in un file Excel" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Name="ExportResult" Classes="muted" HorizontalAlignment="Center"
                           Text="Libri, prestiti e utenti, per la copia di sicurezza o per portarli su un altro computer." />
            </StackPanel>
        </Button>

        <TextBlock DockPanel.Dock="Top" Text="PORTA I DATI DENTRO" Classes="h" />

        <Button Name="DropZone" DockPanel.Dock="Top" Classes="drop" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <Button Name="CloseFile" DockPanel.Dock="Right" Classes="quiet" Content="✕"
                        IsVisible="False" VerticalAlignment="Top" ToolTip.Tip="Chiudi il file" />
                <StackPanel Spacing="4">
                    <TextBlock Name="DropTitle" Text="Scegli un file Excel" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Name="DropHint" Classes="muted" HorizontalAlignment="Center"
                               Text="oppure trascinalo qui.  Accetta .xlsx e .xls" />
                </StackPanel>
            </DockPanel>
        </Button>

        <TextBlock Name="Found" DockPanel.Dock="Top" Margin="0,0,0,10" IsVisible="False" Classes="muted" />
        <TextBlock Name="Errore" DockPanel.Dock="Top" Classes="overdue" TextWrapping="Wrap"
                   Margin="0,0,0,10" IsVisible="False" />

        <!-- Dichiarato per primo, quindi in fondo: il bottone sta sotto e la casella che
             cancella tutto gli sta sopra, dove la si legge prima di premere. -->
        <Border Name="Actions" DockPanel.Dock="Bottom" IsVisible="False" Margin="0,0,0,0">
            <!-- DockPanel e non StackPanel: il riepilogo cambia, e uno StackPanel orizzontale
                 lo lascerebbe disposto con l'ingombro del testo precedente. -->
            <DockPanel LastChildFill="True">
                <Button Name="Apply" Classes="primary" Content="Importa"
                        DockPanel.Dock="Left" Margin="0,0,14,0" />
                <TextBlock Name="Summary" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <Border Name="ReplaceBox" DockPanel.Dock="Bottom" Classes="card" IsVisible="False" Margin="0,12,0,10">
            <StackPanel Spacing="4">
                <CheckBox Name="Replace" Content="Sostituisci tutto l'archivio" FontWeight="SemiBold" />
                <TextBlock Name="ReplaceHint" Classes="muted" TextWrapping="Wrap" Margin="28,0,0,0"
                           Text="Lascialo spento per aggiungere questi dati a quelli che ci sono già." />
            </StackPanel>
        </Border>

        <!-- Una linguetta per foglio: si guarda un foglio alla volta, con le sue colonne
             sempre in chiaro invece che dietro un bottone da aprire. Lo scorrimento sta
             dentro la linguetta, non qui attorno: se scorresse tutto, la striscia delle
             linguette se ne andrebbe su e non sapresti più che foglio stai guardando. -->
        <TabControl Name="Sheets" />
    </DockPanel>
</UserControl>
