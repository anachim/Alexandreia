<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Alexandreia"
             x:Class="Alexandreia.ImportView"
             DragDrop.AllowDrop="True">

    <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <Button Name="Pick" Content="Scegli file…" />
            <TextBlock Name="FileName" VerticalAlignment="Center" Classes="muted" />
        </StackPanel>

        <Border Name="DropZone" DockPanel.Dock="Top" Classes="drop" Margin="0,0,0,10">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="Trascina qui il file Excel" HorizontalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Classes="muted" HorizontalAlignment="Center"
                           Text="oppure usa «Scegli file…».  Accetta .xlsx e .xls" />
            </StackPanel>
        </Border>

        <TextBlock Name="Found" DockPanel.Dock="Top" Margin="0,0,0,10" IsVisible="False" FontWeight="SemiBold" />
        <TextBlock Name="Errore" DockPanel.Dock="Top" Classes="overdue" TextWrapping="Wrap"
                   Margin="0,0,0,10" IsVisible="False" />

        <Border Name="Actions" DockPanel.Dock="Bottom" IsVisible="False" Margin="0,10,0,0">
            <!-- DockPanel e non StackPanel: uno StackPanel orizzontale dimensiona i figli sul
                 contenuto, e un testo che cambia resta disposto con l'ingombro di prima. -->
            <DockPanel LastChildFill="True">
                <Button Name="Apply" Content="Importa" DockPanel.Dock="Left" Margin="0,0,14,0" />
                <TextBlock Name="Result" DockPanel.Dock="Right" VerticalAlignment="Center" Classes="muted" />
                <TextBlock Name="Summary" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <ScrollViewer>
            <StackPanel Name="Sheets" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
