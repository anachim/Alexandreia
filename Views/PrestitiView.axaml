<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Alexandreia"
             x:Class="Alexandreia.PrestitiView">

    <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
            <TextBox Name="Search" Width="300" PlaceholderText="Cerca per titolo o per persona…" />
            <ComboBox Name="Filtro" MinWidth="190" VerticalAlignment="Center" />
            <TextBlock Name="Conteggio" Classes="muted" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Name="Message" DockPanel.Dock="Top" Margin="0,0,0,10" IsVisible="False" />

        <Border Name="ExtendPanel" DockPanel.Dock="Top" Classes="card" IsVisible="False" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Name="ExtendTitle" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="nuova scadenza" VerticalAlignment="Center" Classes="muted" />
                <CalendarDatePicker Name="NewDue" Width="150" />
                <Button Name="ConfirmExtend" Classes="primary" Content="Conferma" />
                <Button Name="CancelExtend" Content="Annulla" />
            </StackPanel>
        </Border>

        <TextBlock Name="Empty" DockPanel.Dock="Bottom" Classes="muted" Margin="0,10,0,0" IsVisible="False" />

        <!-- Fixed widths and resizable columns: with a star-sized column the table squeezes
             titles into illegibility instead of scrolling. -->
        <DataGrid Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" x:DataType="m:Loan"
                  GridLinesVisibility="Horizontal" CanUserSortColumns="True" CanUserResizeColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Titolo" Binding="{Binding Title, Mode=OneWay}" Width="230" />
                <DataGridTextColumn Header="Autore" Binding="{Binding Author, Mode=OneWay}" Width="150" />
                <DataGridTextColumn Header="A chi" Binding="{Binding MemberName, Mode=OneWay}" Width="160" />
                <DataGridTextColumn Header="Prestato il" Width="110"
                                    Binding="{Binding LoanedAt, Mode=OneWay, StringFormat='{}{0:dd/MM/yyyy}'}" />
                <DataGridTextColumn Header="Rientro entro" Width="130"
                                    Binding="{Binding DueLabel, Mode=OneWay}" />
                <!-- The return date lives inside the status: one column less saying the
                     same thing in two places. -->
                <DataGridTemplateColumn Header="Stato" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="m:Loan">
                            <Border Classes="pill" Classes.late="{Binding Overdue}"
                                    Classes.done="{Binding !IsOpen}" Margin="4,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Stato}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Azioni" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="m:Loan">
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,3"
                                        IsVisible="{Binding IsOpen}">
                                <Button Content="Rientrato" Click="OnReturn" Tag="{Binding}" />
                                <Button Content="Prolunga" Click="OnExtend" Tag="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
