<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Alexandreia"
             x:Class="Alexandreia.PrestitiView">

    <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
            <TextBox Name="Search" Width="300" PlaceholderText="Cerca per titolo o per persona…" />
            <ComboBox Name="Filtro" MinWidth="190" VerticalAlignment="Center" />
            <TextBlock Name="Conteggio" Classes="muted" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Name="Message" DockPanel.Dock="Top" Margin="0,0,0,10" IsVisible="False" />
        <TextBlock Name="Empty" DockPanel.Dock="Bottom" Classes="muted" Margin="0,10,0,0" IsVisible="False" />

        <!-- Mode=OneWay ovunque: i DataGridTextColumn riscrivono nel modello anche con IsReadOnly. -->
        <DataGrid Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" x:DataType="m:Loan"
                  GridLinesVisibility="Horizontal" CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Titolo" Binding="{Binding Title, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="Autore" Binding="{Binding Author, Mode=OneWay}" Width="150" />
                <DataGridTextColumn Header="A chi" Binding="{Binding MemberName, Mode=OneWay}" Width="180" />
                <DataGridTextColumn Header="Prestato il" Width="120"
                                    Binding="{Binding LoanedAt, Mode=OneWay, StringFormat='{}{0:dd/MM/yyyy}'}" />
                <DataGridTextColumn Header="Rientro entro" Width="130"
                                    Binding="{Binding DueLabel, Mode=OneWay}" />
                <DataGridTemplateColumn Header="" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="m:Loan">
                            <!-- Il timbro della scadenza: l'unico posto dove il programma alza la voce. -->
                            <Border Classes="stamp" IsVisible="{Binding Overdue}" Margin="4,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding LateLabel}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Rientrato" Width="115"
                                    Binding="{Binding ReturnedAt, Mode=OneWay, StringFormat='{}{0:dd/MM/yyyy}'}" />
                <DataGridTemplateColumn Header="" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="m:Loan">
                            <Button Content="Rientrato" Click="OnReturn" Tag="{Binding}" Margin="4,3"
                                    IsVisible="{Binding IsOpen}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
