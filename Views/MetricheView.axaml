<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Alexandreia"
             x:Class="Alexandreia.MetricheView">

    <ScrollViewer>
        <StackPanel Spacing="0">

            <TextBlock Text="ADESSO" Classes="h" Margin="0,0,0,10" />
            <WrapPanel Name="Now" />

            <TextBlock Text="IN UN PERIODO" Classes="h" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                <ComboBox Name="Period" MinWidth="180" />
                <CalendarDatePicker Name="From" Width="150" IsVisible="False" />
                <CalendarDatePicker Name="To" Width="150" IsVisible="False" />
                <TextBlock Name="Range" Classes="muted" VerticalAlignment="Center" />
            </StackPanel>

            <WrapPanel Name="Cards" />

            <TextBlock Text="PRESTITI PER MESE" Classes="h" />
            <ItemsControl Name="Months">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:Bar">
                        <Grid ColumnDefinitions="80,50,400" Margin="0,2">
                            <TextBlock Text="{Binding Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding Count}" />
                            <Border Grid.Column="2" Background="{DynamicResource Stamp}" Height="12"
                                    CornerRadius="2" Width="{Binding Width}" HorizontalAlignment="Left" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Name="NoMonths" Classes="muted" Text="Nessun prestito nel periodo." IsVisible="False" />

            <TextBlock Text="LIBRI PIÙ PRESTATI" Classes="h" />
            <ItemsControl Name="Top">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:Bar">
                        <Grid ColumnDefinitions="280,170,200,50,200" Margin="0,2">
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Sub}" Classes="muted"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Note}" Classes="muted"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding Count}" />
                            <Border Grid.Column="4" Background="{DynamicResource Stamp}" Height="12"
                                    CornerRadius="2" Width="{Binding Width}" HorizontalAlignment="Left" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Name="NoTop" Classes="muted" Text="Nessun prestito nel periodo." IsVisible="False" />

            <TextBlock Text="MAI USCITI" Classes="h" />
            <ItemsControl Name="Never">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:Book">
                        <Grid ColumnDefinitions="300,200,*" Margin="0,2">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Author}" Classes="muted" />
                            <TextBlock Grid.Column="2" Text="{Binding Notes}" Classes="muted"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Name="NoNever" Classes="muted" IsVisible="False"
                       Text="Tutti i libri sono stati prestati almeno una volta." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
