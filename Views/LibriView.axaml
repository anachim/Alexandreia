<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Alexandreia"
             x:Class="Alexandreia.LibriView">

    <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <TextBox Name="Search" Width="300" PlaceholderText="Cerca titolo, autore, nota…" />
            <CheckBox Name="OnlyAvailable" Content="Solo disponibili" VerticalAlignment="Center" />
            <Button Name="New" Classes="primary" Content="Nuovo libro" />
        </StackPanel>

        <TextBlock Name="Message" DockPanel.Dock="Top" TextWrapping="Wrap"
                   Margin="0,0,0,10" IsVisible="False" />

        <Border Name="LendPanel" DockPanel.Dock="Top" Classes="card" IsVisible="False" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Name="LendTitle" VerticalAlignment="Center" FontWeight="SemiBold" />
                <ComboBox Name="Person" MinWidth="220" PlaceholderText="A chi?" />
                <TextBlock Text="rientro entro" VerticalAlignment="Center" Classes="muted" />
                <CalendarDatePicker Name="DueAt" Width="150" />
                <Button Name="ConfirmLend" Classes="primary" Content="Conferma" />
                <Button Name="CancelLend" Content="Annulla" />
            </StackPanel>
        </Border>

        <TextBlock Name="Empty" DockPanel.Dock="Bottom" Classes="muted" Margin="0,10,0,0" IsVisible="False" />

        <!-- Mode=OneWay: i DataGridTextColumn riscrivono nel modello anche con IsReadOnly. -->
        <!-- Larghezze fisse e colonne ridimensionabili: con una colonna elastica la tabella
             si stringe fino a rendere illeggibili i titoli invece di far scorrere. -->
        <DataGrid Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" x:DataType="m:Book"
                  GridLinesVisibility="Horizontal" CanUserSortColumns="True" CanUserResizeColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Titolo" Binding="{Binding Title, Mode=OneWay}" Width="280" />
                <DataGridTextColumn Header="Autore" Binding="{Binding Author, Mode=OneWay}" Width="200" />
                <DataGridTextColumn Header="Nota" Binding="{Binding Notes, Mode=OneWay}" Width="220" />
                <DataGridTextColumn Header="Prestato a" Binding="{Binding LentTo, Mode=OneWay}" Width="180" />
                <DataGridTemplateColumn Header="Azioni" Width="250">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="m:Book">
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,2">
                                <Button Content="Presta" Click="OnLend"
                                        IsEnabled="{Binding IsAvailable}" Tag="{Binding}" />
                                <Button Content="Modifica" Click="OnEdit" Tag="{Binding}" />
                                <Button Content="Archivia" Click="OnArchive" Tag="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
