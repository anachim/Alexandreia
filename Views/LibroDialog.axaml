<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Alexandreia.LibroDialog"
        Title="Libro" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False">

    <StackPanel Margin="20" Spacing="10">

        <StackPanel Spacing="3">
            <TextBlock Text="Titolo" Classes="muted" />
            <TextBox Name="Titolo" />
        </StackPanel>

        <StackPanel Spacing="3">
            <TextBlock Text="Autore" Classes="muted" />
            <TextBox Name="Autore" />
        </StackPanel>

        <StackPanel Spacing="3">
            <TextBlock Text="Nota" Classes="muted" />
            <TextBox Name="Nota" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Name="Errore" Classes="overdue" IsVisible="False" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Name="Annulla" Content="Annulla" IsCancel="True" />
            <Button Name="Salva" Classes="primary" Content="Salva" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
